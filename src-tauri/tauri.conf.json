{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kyty Launcher",
  "version": "0.1.4",
  "identifier": "dev.kytylauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kyty Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0c11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Kyty Launcher",
    "shortDescription": "A modern launcher for the KytyPS5 emulator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMUU2RDU0ODNEOEE2MzEKUldReHB0aURWRzBlcXZZdWVDV2h2YTZsYTR3NlhCZFdPVkFFamJMZ3F5TmF3azhvdk15cnBjZHoK",
      "endpoints": ["https://github.com/SillyCatty/kyty-ux-launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
